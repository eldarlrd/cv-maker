#actions
  gap 0.25rem
  display flex
  overflow clip
  padding-top 0.75rem
  justify-content flex-end

  .action-btn
    border 0
    margin 0 1px
    gap 0.375rem
    min-width 3rem
    cursor pointer
    display inherit
    height 2.875rem
    font-size 1.25rem
    align-items center
    justify-content center
    border-radius border-curve
    transition transition-config
    -webkit-tap-highlight-color tap-fg
    transition-property color, outline, background

    &:focus-visible
      outline edge-style highlight

    &:disabled
      color field-bg
      cursor not-allowed
      background transparent

    @media (hover hover)
      &:hover:not(:disabled)
        background main-bg

  #clear-btn
    aspect-ratio 1 / 1
    color main-bg
    background main-clear

    @media (hover hover)
      &:hover
        background hover-clear

  #download-btn
    color main-bg
    background main-download
    min-width 9.25rem

    &:disabled
      color field-bg
      background transparent

    @media (hover hover)
      &:hover:not(:disabled)
        background hover-download
