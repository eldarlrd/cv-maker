#actions
  gap 0.25rem
  display flex
  overflow clip
  padding-top 0.75rem
  justify-content flex-end

  .action-btn
    border 0
    margin 0 1px
    gap 0.375rem
    min-width 3rem
    cursor pointer
    display inherit
    height 2.875rem
    font-size 1.25rem
    align-items center
    justify-content center
    border-radius border-curve
    transition transition-config
    -webkit-tap-highlight-color tap-fg
    transition-property color, outline, background

    &:focus-visible
      outline edge-style highlight

    &:disabled
      color field-bg
      cursor not-allowed
      background transparent

    @media (hover hover)
      &:hover:not(:disabled)
        background main-bg

  #clear-btn
    color main-bg
    aspect-ratio 1 / 1
    background main-clear

    @media (hover hover)
      &:hover
        background hover-clear

  #copy-btn
    color main-bg
    aspect-ratio 1 / 1
    background main-copy

    @media (hover hover)
      &:hover
        background hover-copy

  #paste-btn
    color main-bg
    aspect-ratio 1 / 1
    background main-paste

    @media (hover hover)
      &:hover:not(:disabled)
        background hover-paste

  #download-btn
    color main-bg
    background main-download
    min-width 9.25rem

    @media (hover hover)
      &:hover:not(:disabled)
        background hover-download

  #copy-btn:disabled
  #download-btn:disabled
  #paste-btn:disabled
    color field-bg
    background transparent
