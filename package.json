{
  "name": "cv-maker",
  "private": true,
  "version": "1.4.5",
  "type": "module",
  "keywords": [
    "resume builder",
    "cv maker"
  ],
  "description": "A Resume Builder",
  "repository": "github:eldarlrd/cv-maker",
  "homepage": "https://eldarlrd.is-a.dev/cv-maker",
  "author": "Eldar Paşazadə <eldarlrd@pm.me> (https://eldarlrd.is-a.dev)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --open",
    "bundle": "tsc -b && vite build",
    "serve": "vite preview",
    "deployer": "bun bundle && gh-pages -b prod -m 'build(prod): deployment' -d dist",
    "fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
    "orphans": "knip --cache --no-exit-code"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "modern-normalize": "^3.0.1",
    "nanoid": "^6.0.1",
    "non.geist": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-to-print": "^3.3.0",
    "stylus": "^0.64.0",
    "tippy.js": "^6.3.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "gh-pages": "^6.3.0",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
